# Copy each name into Hosting.com’s Node.js environment-variable controls.
# Never upload this file after adding real secrets.
NODE_ENV=production
DATABASE_URL=mysql://CPANEL_DB_USER:GENERATED_DB_PASSWORD@127.0.0.1:3306/CPANEL_DATABASE_NAME
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Optional S3-compatible storage for future administrator uploads.
# Leave all six blank until a provider and private bucket are ready.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional legacy Manus OAuth compatibility; not required for staff email/password login.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
